<?xml version="1.0" encoding="UTF-8"?>
<!-- shared-mime-info definitions for types the system database may not have.
     Installed to /usr/share/mime/packages/ (update-mime-database runs on install). -->
<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">
  <mime-type type="application/x-polykrom">
    <comment>Polykrom design</comment>
    <icon name="app.polykrom.Polykrom"/>
    <sub-class-of type="application/json"/>
    <glob pattern="*.polykrom"/>
    <!-- Designs from SolidCraft, which Polykrom is forked from, and from its earliest releases:
         the same container, still opened (docs/compatibility.md). -->
    <glob pattern="*.solidcraft"/>
    <alias type="application/x-solidcraft"/>
    <glob pattern="*.solvecraft"/>
    <alias type="application/x-solvecraft"/>
  </mime-type>
</mime-info>
